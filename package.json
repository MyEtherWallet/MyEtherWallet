{
  "name": "myetherwallet",
  "version": "7.0.8",
  "private": true,
  "type": "module",
  "engines": {
    "pnpm": ">=10.28.2",
    "node": ">=v22.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build:only {@}\" --",
    "test:unit": "vitest",
    "test:e2e": "nightwatch --config ./nightwatch.conf.cjs tests/e2e/*",
    "build:preview": "vite preview",
    "build:only": "vite build",
    "build:watchonly": "vite build --watch",
    "type-check": "vue-tsc -p tsconfig.app.json",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "prepare": "husky",
    "zip": "cd dist; zip -r release.zip *;",
    "update-api-schema": "npx openapi-typescript https://mew-api-dev.ethvm.dev/schema.yaml -o src/mew_api/schema.ts",
    "update-rewards-schema": "npx openapi-typescript https://mew-rewards-prod.ethvm.dev/schema.yaml -o src/mew_api/schemaRewards.ts"
  },
