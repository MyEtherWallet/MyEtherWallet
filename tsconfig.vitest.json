// https://www.typescriptlang.org/tsconfig
//
// TypeScript config for tests
{
  "extends": "./tsconfig.app.json",
  // Stop excluding test files and directories
  "exclude": [],
  // tsconfig.app.json only includes src/**, so the mirrored tests/unit tree needs
  // adding here. tests/e2e is left out — Nightwatch owns it via nightwatch/tsconfig.json.
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "tests/unit/**/*"],
  "compilerOptions": {
    // Project
    "composite": true, // https://www.typescriptlang.org/tsconfig/#composite
    "incremental": true, // https://www.typescriptlang.org/tsconfig/#incremental
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo", // https://www.typescriptlang.org/tsconfig/#tsBuildInfoFile

    // Language & Environment
    // NodeJS types and JSDOM (mock of browser dom) are available within the the Vitest environment
    "types": ["node", "jsdom"]
  }
}
